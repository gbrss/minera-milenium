  truck: '<path d="M2 6h11v10H2zM13 9h5l3 3v4h-8z"/><circle cx="6.500" cy="17.500" r="1.800"/><circle cx="17" cy="17.500" r="1.800"/>',
  chart: '<path d="M4 20V14M10 20V10M16 20V12M22 20V6"/><path d="M3 9l6-5 4 3 7-4"/>',
