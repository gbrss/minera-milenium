  contract: '<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 12h7M9 15h7M9 18h4"/>',
  dollar: '<circle cx="12" cy="12" r="9"/><path d="M12 6v12M15 9.2c-.6-1-1.7-1.5-3-1.5-1.7 0-3 .8-3 2.1 0 3 6 1.4 6 4.3 0 1.3-1.300 2.100-3 2.100-1.400 0-2.600-.6-3.200-1.600"/>',
