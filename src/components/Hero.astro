---
import Icon from './Icon.astro';
---
<section class="hero" id="inicio">
  <div class="container">
    <div class="hero-grid">
      <div class="reveal">
        <span class="eyebrow">Comercializadora de minerales para exportación</span>
        <h1>Minerales que <span class="gold">conectan el futuro</span></h1>
        <p class="lead">
          Impulsamos la nueva minería con compra directa, transparente y a largo plazo a la pequeña y
          mediana minería. Desde Atacama y Tarapacá, conectamos los minerales de Chile con el mundo.
        </p>
        <div class="hero-cta">
          <a class="btn btn-gold" href="#poder-de-compra">Ver poder de compra <Icon name="arrow" size={18} /></a>
          <a class="btn btn-ghost" href="#contacto">Contáctanos</a>
        </div>
        <div class="hero-strip">
          <span>Minerales de calidad</span><span>Procesos responsables</span><span>Futuro sustentable</span>
        </div>
      </div>
      <div class="hero-logo reveal">
        <img src="/img/logo.png" alt="Minera Milenium"  fetchpriority="high" />
      </div>
    </div>
  </div>
</section>
