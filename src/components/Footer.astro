---
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <img src="/img/logo-sm.png" alt="Minera Milenium" width="256" height="137" loading="lazy" />
        <p>Comercializadora de minerales para exportación. Confianza, transparencia y compromiso con el desarrollo local.</p>
      </div>
      <nav class="footer-links" aria-label="Pie de página">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
    </div>
    <div class="footer-bottom">
      <span>© {year} {site.legal}. Todos los derechos reservados.</span>
      <span class="motto">{site.tagline}</span>
    </div>
  </div>
</footer>
